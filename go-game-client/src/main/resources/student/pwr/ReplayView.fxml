<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>

<VBox spacing="10.0" prefHeight="860.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="student.pwr.controller.ReplayController">
    <children>
        <!-- Header with game info -->
        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="700.0" spacing="5.0" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <children>
                <Label fx:id="titleLabel" text="Game Replay" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <HBox alignment="CENTER" spacing="30.0">
                    <Label fx:id="blackInfoLabel" text="Black: Player1" style="-fx-font-size: 14px; -fx-text-fill: #ecf0f1;"/>
                    <Label fx:id="resultLabel" text="Result: W+5.5" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #f1c40f;"/>
                    <Label fx:id="whiteInfoLabel" text="White: Player2" style="-fx-font-size: 14px; -fx-text-fill: #ecf0f1;"/>
                </HBox>
            </children>
        </VBox>

        <!-- Navigation controls -->
        <HBox alignment="CENTER" spacing="15.0" prefHeight="50.0" style="-fx-background-color: #34495e; -fx-padding: 10;">
            <children>
                <Button fx:id="firstButton" text="⏮ First" onAction="#onFirstClicked" prefWidth="80.0" style="-fx-font-size: 14px;"/>
                <Button fx:id="prevButton" text="◀ Prev" onAction="#onPrevClicked" prefWidth="80.0" style="-fx-font-size: 14px;"/>
                <Label fx:id="moveCounterLabel" text="Move: 0 / 0" prefWidth="120.0" alignment="CENTER" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Button fx:id="nextButton" text="Next ▶" onAction="#onNextClicked" prefWidth="80.0" style="-fx-font-size: 14px;"/>
                <Button fx:id="lastButton" text="Last ⏭" onAction="#onLastClicked" prefWidth="80.0" style="-fx-font-size: 14px;"/>
                <Region prefWidth="20.0"/>
                <Button fx:id="autoPlayButton" text="▶ Auto" onAction="#onAutoPlayClicked" prefWidth="80.0" style="-fx-font-size: 14px; -fx-background-color: #27ae60; -fx-text-fill: white;"/>
            </children>
        </HBox>

        <!-- Board -->
        <Pane fx:id="replayPane" prefHeight="650.0" prefWidth="700.0"/>

        <!-- Footer -->
        <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 10;">
            <children>
                <Label fx:id="currentMoveLabel" text="Empty board" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="backButton" text="Back to History" onAction="#onBackClicked" prefWidth="140.0" prefHeight="35.0" style="-fx-font-size: 14px; -fx-background-color: #95a5a6; -fx-text-fill: white;"/>
            </children>
        </HBox>
    </children>
</VBox>
